PROJECT_NAME=pandawiki

# Public access
SERVER_IP=YOUR_SERVER_IP
ADMIN_PORT=18080
APP_PORT=3010
API_PORT=8000

# Internal services
POSTGRES_PORT=5432
REDIS_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222
QDRANT_PORT=6333
RAGLITE_PORT=5050

# Secrets
POSTGRES_DB=panda-wiki
RAGLITE_POSTGRES_DB=panda-wiki-raglite
POSTGRES_USER=panda-wiki
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
# Generate distinct URL-safe secrets, e.g. openssl rand -hex 24.
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
NATS_PASSWORD=CHANGE_ME_NATS_PASSWORD
# OSS is configured in the repository root .env. See ../../.env.example.

JWT_SECRET=CHANGE_ME_JWT_SECRET
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
QDRANT_API_KEY=CHANGE_ME_QDRANT_API_KEY
RAGLITE_API_KEY=sk-CHANGE_ME_RAGLITE_API_KEY
# RAGLite table LLM enhancement limit. 0 disables table analysis warnings/cost;
# set to 30 to restore the upstream default after using a compatible analysis model.
RAGLITE_WORKER_MAX_TABLES=0

# App runtime
SENTRY_ENABLED=false
LOG_LEVEL=0
PDF_PARSER_TOKEN=
PDF_PARSER_BASE_IMAGE=registry.cn-hangzhou.aliyuncs.com/misaka-images/python:3.12-slim-bookworm
PDF_PARSER_APT_MIRROR=https://deb.debian.org
PDF_PARSER_WORKERS=1
PDF_PARSER_MAX_PAGES=500
PDF_PARSER_JOB_TIMEOUT_SECONDS=900
# Optional existing crawler fallback. Leave blank when not deployed.
ANYDOC_CRAWLER_BASE_URL=
# 全量运行日志默认保留 14 天，由部署中的 Loki + Alloy 自动采集。

# Compose image overrides
POSTGRES_IMAGE=registry.cn-hangzhou.aliyuncs.com/misaka-images/postgres:15.17
REDIS_IMAGE=registry.cn-hangzhou.aliyuncs.com/misaka-images/redis:7.4
NATS_IMAGE=registry.cn-hangzhou.aliyuncs.com/misaka-images/nats:2.14.1
QDRANT_IMAGE=registry.cn-hangzhou.aliyuncs.com/misaka-images/qdrant:v1.14.1
RAGLITE_IMAGE=registry.cn-hangzhou.aliyuncs.com/misaka-images/raglite:v2.17.0

# Frontend build package registry. Override when the server cannot access npmjs.org.
COREPACK_NPM_REGISTRY=https://registry.npmmirror.com
NPM_CONFIG_REGISTRY=https://registry.npmmirror.com

# Optional exact host names (without ports), comma-separated. Empty permits IP
# literals and localhost; deployments accessed by DNS must list their DNS names.
SECURITY_ALLOWED_HOSTS=
# Exact browser origins only if cross-origin API use is needed. No wildcard.
SECURITY_ALLOWED_ORIGINS=

# Account JWT sessions: 8h absolute lifetime, 30min since last authenticated request.
AUTH_SESSION_MAX_AGE_SECONDS=28800
AUTH_SESSION_IDLE_SECONDS=1800

# Separate credentials are generated by deploy.sh when absent. Do not reuse NATS_PASSWORD.
NATS_MONITOR_PASSWORD=
PREVIEW_PASSWORD=
# Set true once HTTPS is deployed. HTTPS forwarded requests also receive Secure.
AUTH_COOKIE_SECURE=false
