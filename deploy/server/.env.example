PROJECT_NAME=pandawiki

# Public access
SERVER_IP=YOUR_SERVER_IP
ADMIN_PORT=18080
APP_PORT=3010
API_PORT=8000

# Internal services
POSTGRES_PORT=5432
REDIS_PORT=6379
NATS_PORT=4222
NATS_MONITOR_PORT=8222
QDRANT_PORT=6333
RAGLITE_PORT=5050

# Secrets
POSTGRES_DB=panda-wiki
RAGLITE_POSTGRES_DB=panda-wiki-raglite
POSTGRES_USER=panda-wiki
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
# OSS is configured in the repository root .env. See ../../.env.example.

JWT_SECRET=CHANGE_ME_JWT_SECRET
ADMIN_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
QDRANT_API_KEY=CHANGE_ME_QDRANT_API_KEY
RAGLITE_API_KEY=sk-CHANGE_ME_RAGLITE_API_KEY

# App runtime
SENTRY_ENABLED=false
LOG_LEVEL=0
# 全量运行日志默认保留 14 天，由部署中的 Loki + Alloy 自动采集。

# Compose image overrides
POSTGRES_IMAGE=registry.cn-hangzhou.aliyuncs.com/misaka-images/postgres:15.17
REDIS_IMAGE=registry.cn-hangzhou.aliyuncs.com/misaka-images/redis:7.4
NATS_IMAGE=registry.cn-hangzhou.aliyuncs.com/misaka-images/nats:2.14.1
QDRANT_IMAGE=chaitin-registry.cn-hangzhou.cr.aliyuncs.com/chaitin/panda-wiki-qdrant:v1.14.1
RAGLITE_IMAGE=chaitin-registry.cn-hangzhou.cr.aliyuncs.com/chaitin/raglite:v2.17.0
