# If you prefer the allow list template instead of the deny list, see community template:
# https://github.com/github/gitignore/blob/main/community/Golang/Go.AllowList.gitignore
#
# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

.cache
.gocache/
.local-data/
# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
# vendor/

# Go workspace file
go.work
go.work.sum

# env file
.env
!.env.example

**/.DS_Store

.vscode

deploy
!deploy/
!deploy/server/
deploy/server/*
!deploy/server/.env.example
!deploy/server/README.md
!deploy/server/deploy.sh
!deploy/server/tests/
deploy/server/tests/*
!deploy/server/tests/upgrade-paused-consumer.sh
!deploy/server/docker-compose.yml
!deploy/server/postgres-init/
!deploy/server/postgres-init/01-create-raglite-db.sql
!deploy/server/security/
!deploy/server/security/nats.conf
!deploy/server/logging/
!deploy/server/logging/config.alloy
!deploy/server/logging/config.local.alloy
!deploy/server/logging/loki.yml
local

.idea
__debug*

.app-ssl/
.data/
.logs/
.pids/
*.log
*.pid
backend/tmp_*.go
backend/migration/migration

.gocache/
.pnpm-store/
web/packages/collab-service/data/

# Local-only verification binaries and ephemeral service credentials.
tmp/security-followup-20261026/*.env
tmp/security-followup-20261026/credentials.txt
tmp/security-followup-20261026/security-proxy

# Local verification scripts, captures, and compiled artifacts.
/tmp/

# Generated local PDF.js reader assets
web/admin/public/pdfjs/
web/app/public/pdfjs/
